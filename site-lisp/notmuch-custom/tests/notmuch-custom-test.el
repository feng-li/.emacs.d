;;; notmuch-custom-test.el --- IMAP star sync tests -*- lexical-binding: t; -*-
;;; Code:
(require 'ert)
(require 'cl-lib)
(require 'notmuch-custom)

(ert-deftest notmuch-custom-stars-read-only-protocol ()
  (let* ((buffer (generate-new-buffer " *imap-star-test*"))
         (process (make-pipe-process :name "imap-star-test" :buffer buffer))
         commands)
    (cl-letf (((symbol-function 'notmuch-custom--imap-connect)
               (lambda (_) process))
              ((symbol-function 'notmuch-custom--imap-command)
               (lambda (_ command _description)
                 (push command commands)
                 (cond
                  ((equal command "UID SEARCH FLAGGED") "* SEARCH 12 34\r\nNM OK\r\n")
                  ((string-prefix-p "UID FETCH 12 " command)
                   "* 1 FETCH (BODY[HEADER.FIELDS (MESSAGE-ID)] {30}\r\nMessage-ID: <one@example.org>\r\n\r\n)\r\nNM OK\r\n")
                  ((string-prefix-p "UID FETCH 34 " command)
                   "* 2 FETCH (BODY[HEADER.FIELDS (MESSAGE-ID)] {32}\r\nMessage-ID:\r\n <two@example.org>\r\n\r\n)\r\nNM OK\r\n")
                  (t "NM OK\r\n")))))
      (should (equal (sort (notmuch-custom--imap-starred-account-ids nil '("INBOX"))
                           #'string-lessp)
                     '("one@example.org" "two@example.org")))
      (should (member "EXAMINE \"INBOX\"" commands))
      (should (member "LOGOUT" commands))
      (should-not (process-live-p process))
      (should-not (buffer-live-p buffer)))))

(ert-deftest notmuch-custom-stars-reject-incomplete-fetch ()
  (let* ((buffer (generate-new-buffer " *imap-star-test*"))
         (process (make-pipe-process :name "imap-star-test" :buffer buffer)))
    (cl-letf (((symbol-function 'notmuch-custom--imap-connect) (lambda (_) process))
              ((symbol-function 'notmuch-custom--imap-command)
               (lambda (_ command _description)
                 (if (equal command "UID SEARCH FLAGGED")
                     "* SEARCH 12\r\nNM OK\r\n"
                   "NM OK\r\n"))))
      (should-error (notmuch-custom--imap-starred-account-ids nil '("INBOX")))
      (should-not (process-live-p process))
      (should-not (buffer-live-p buffer)))))

(ert-deftest notmuch-custom-stars-diff-and-failure ()
  (let* ((account '(:local-root "/mail"))
         (notmuch-custom-imap-post-send-accounts (list account))
         (remote '("new@example.org" "kept@example.org"))
         changes fail)
    (cl-letf (((symbol-function 'notmuch--process-lines)
               (lambda (&rest _) '("/mail/INBOX/cur/1" "/mail/INBOX/cur/2")))
              ((symbol-function 'notmuch-custom--imap-starred-account-ids)
               (lambda (actual folders)
                 (should (equal actual account))
                 (should (equal folders '("INBOX")))
                 (if fail (error "Disconnected") remote)))
              ((symbol-function 'notmuch-custom--imap-message-ids)
               (lambda (query)
                 (should (equal query "tag:imap-starred"))
                 '("old@example.org" "kept@example.org")))
              ((symbol-function 'notmuch-tag)
               (lambda (query tags &rest _) (push (list query tags) changes))))
      (notmuch-custom-sync-imap-starred)
      (should (= (length changes) 2))
      (should (member (list (notmuch-id-to-query "new@example.org") '("+imap-starred")) changes))
      (should (member (list (notmuch-id-to-query "old@example.org") '("-imap-starred")) changes))
      (setq changes nil fail t)
      (should-error (notmuch-custom-sync-imap-starred))
      (should-not changes)
      ;; A successful empty scan really does clear previous server stars.
      (setq fail nil remote nil)
      (notmuch-custom-sync-imap-starred)
      (should (= (length changes) 1))
      (should (equal (cadar changes) '("-imap-starred"))))))

(ert-deftest notmuch-custom-stars-failure-still-refreshes ()
  (let ((notmuch-custom-imap-starred-sync t) refreshed)
    (cl-letf (((symbol-function 'notmuch-poll) #'ignore)
              ((symbol-function 'notmuch-custom-sync-imap-starred)
               (lambda () (error "Offline")))
              ((symbol-function 'notmuch-refresh-all-buffers)
               (lambda () (setq refreshed t))))
      (notmuch-custom-poll-and-refresh)
      (should refreshed))))

(ert-deftest notmuch-custom-stars-unconfigured-noop ()
  (let ((notmuch-custom-imap-post-send-accounts nil))
    (cl-letf (((symbol-function 'notmuch--process-lines)
               (lambda (&rest _) (ert-fail "Should not query mail"))))
      (should-not (notmuch-custom-sync-imap-starred)))))
