(ert-deftest notmuch-thread-view-parent-command-closes-both-panes ()
  "Return to the recorded folder, closing both panes without tagging mail."
  (dolist (focus '(tree preview))
    (let ((parent (generate-new-buffer " *parent-folder-test*"))
          (tree (generate-new-buffer " *parent-tree-test*"))
          (preview (generate-new-buffer " *parent-preview-test*"))
          (notmuch-show-mark-read-tags nil))
      (unwind-protect
          (save-window-excursion
            (delete-other-windows)
            (switch-to-buffer tree)
            (notmuch-tree-mode)
            (setq-local notmuch-tree-parent-buffer parent)
            (let ((inhibit-read-only t))
              (notmuch-custom--tree-insert-reversed
               #'notmuch-tree-insert-forest-thread
               (notmuch-thread-view-test--thread)))
            (goto-char (point-min))
            (cl-letf (((symbol-function 'notmuch-show)
                       (lambda (&rest _)
                         (switch-to-buffer preview)
                         (setq major-mode 'notmuch-show-mode)
                         preview)))
              (notmuch-custom--tree-preview-layout #'notmuch-tree-show-message-in))
            (when (eq focus 'preview)
              (select-window notmuch-tree-message-window))
            (notmuch-custom-parent-view)
            (should (eq (current-buffer) parent))
            (should (eq (window-buffer) parent))
            (should (= (length (window-list)) 1))
            (should-not (buffer-live-p tree))
            (should-not (buffer-live-p preview)))
        (dolist (buffer (list parent tree preview))
          (when (buffer-live-p buffer) (kill-buffer buffer)))))))

(ert-deftest notmuch-thread-view-message-navigation-keeps-preview-focus ()
  "Follow real thread rows in both layouts, including boundary and cleanup."
  (let ((advised (advice-member-p #'notmuch-custom--tree-preview-layout
                                  'notmuch-tree-show-message-in)))
    (unwind-protect
        (progn
          (unless advised
            (advice-add 'notmuch-tree-show-message-in :around
                        #'notmuch-custom--tree-preview-layout))
          (dolist (layout '(side-by-side stacked))
            (let ((tree (generate-new-buffer " *message-nav-tree*"))
                  (notmuch-custom-tree-preview-layout layout)
                  (notmuch-custom-tree-reverse-order t)
                  (notmuch-show-mark-read-tags nil)
                  previews)
              (unwind-protect
                  (save-window-excursion
                    (delete-other-windows)
                    (switch-to-buffer tree)
                    (notmuch-tree-mode)
                    (let ((inhibit-read-only t))
                      (notmuch-custom--tree-insert-reversed
                       #'notmuch-tree-insert-forest-thread
                       (notmuch-thread-view-test--thread)))
                    (goto-char (point-min))
                    (cl-letf (((symbol-function 'notmuch-show)
                               (lambda (query &rest _)
                                 (let ((preview (generate-new-buffer " *message-nav-preview*")))
                                   (push (cons query preview) previews)
                                   (switch-to-buffer preview)
                                   (setq major-mode 'notmuch-show-mode)
                                   preview))))
                      (notmuch-tree-show-message-in)
                      (select-window notmuch-tree-message-window)
                      (notmuch-custom-message-previous-message)
                      (should (eq (current-buffer) (cdar previews)))
                      (should (= (length previews) 1))
                      (notmuch-custom-message-next-message)
                      (should (equal (caar previews) "id:child"))
                      (should (eq (current-buffer) (cdar previews)))
                      (should (eq (selected-window)
                                  (buffer-local-value 'notmuch-tree-message-window tree)))
                      (should-not (buffer-live-p (cdr (cadr previews))))
                      (let ((tree-edges (window-edges (get-buffer-window tree)))
                            (preview-edges (window-edges)))
                        (if (eq layout 'side-by-side)
                            (should (= (nth 1 tree-edges) (nth 1 preview-edges)))
                          (should (= (car tree-edges) (car preview-edges)))))
                      (notmuch-custom-message-next-message 20)
                      (should (equal (caar previews) "id:parent"))
                      (should (eq (current-buffer) (cdar previews)))
                      (let ((before (length previews)))
                        (notmuch-custom-message-next-message)
                        (should (= before (length previews))))
                      (notmuch-custom-message-previous-message 20)
                      (should (equal (caar previews) "id:newer"))
                      (should (eq (current-buffer) (cdar previews)))
                      (should (= (length (window-list)) 2))))
                (when (buffer-live-p tree) (kill-buffer tree))
                (dolist (entry previews)
                  (when (buffer-live-p (cdr entry)) (kill-buffer (cdr entry))))))))
      (unless advised
        (advice-remove 'notmuch-tree-show-message-in
                       #'notmuch-custom--tree-preview-layout)))))

(ert-deftest notmuch-thread-view-standalone-message-navigation-uses-native-commands ()
  (with-temp-buffer
    (setq major-mode 'notmuch-show-mode)
    (let ((next 0) (previous 0))
      (cl-letf (((symbol-function 'notmuch-show-next-message)
                 (lambda (&rest _) (cl-incf next)))
                ((symbol-function 'notmuch-show-previous-message)
                 (lambda () (cl-incf previous))))
        (notmuch-custom-message-next-message 2)
        (notmuch-custom-message-previous-message 3)
        (should (= next 2))
        (should (= previous 3))))))

(ert-deftest notmuch-thread-view-key-hints-toggle-and-preserve-existing-header ()
  (let ((notmuch-custom-show-key-hints t))
    (with-temp-buffer
      (setq major-mode 'notmuch-show-mode)
      (setq-local header-line-format "Existing header")
      (notmuch-custom--install-key-hints)
      (notmuch-custom--install-key-hints)
      (should notmuch-custom--key-hint-face-cookie)
      (should (string-match-p (regexp-quote "Alt+Up/Down")
                              (notmuch-custom--key-hint-text)))
      (should (equal notmuch-custom--saved-header-line "Existing header"))
      (let ((notmuch-custom-show-key-hints nil))
        (notmuch-custom--refresh-key-hints)
        (should (equal header-line-format "Existing header"))
        (should-not notmuch-custom--key-hint-face-cookie))
      (notmuch-custom--install-key-hints)
      (should notmuch-custom--key-hints-installed)
      (setq major-mode 'notmuch-tree-mode)
      (setq-local notmuch-tree-unthreaded nil)
      (should (string-match-p "Up/Down: email" (notmuch-custom--key-hint-text)))
      (setq-local notmuch-tree-unthreaded t)
      (should (string-match-p "RET: thread" (notmuch-custom--key-hint-text))))
    (with-temp-buffer
      (setq-local header-line-format "Unrelated")
      (notmuch-custom--install-key-hints)
      (should (equal header-line-format "Unrelated")))))

