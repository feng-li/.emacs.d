           (lambda ()
             (let ((preview (split-window-vertically)))
               (should (= (window-total-width preview) (window-total-width)))
               (should (> (nth 1 (window-edges preview))
                          (nth 1 (window-edges))))))))))))

(ert-deftest notmuch-thread-view-flat-preview-keeps-native-layout ()
