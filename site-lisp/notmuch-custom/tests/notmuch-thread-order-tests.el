;;; notmuch-thread-order-tests.el --- Opened thread order -*- lexical-binding: t; -*-

;;; Code:
(require 'ert)
(require 'cl-lib)
(require 'notmuch-custom)

(defun notmuch-thread-test--message (id timestamp &optional match)
  (list :id id :timestamp timestamp :match match :tags '("inbox" "unread")
        :headers (list :Subject id :From "Sender <sender@example.org>"
                       :To "Recipient <recipient@example.org>"
                       :Date "Sat, 17 Oct 2026 09:00:00 +0800")
        :body nil))

(ert-deftest notmuch-thread-newest-first-sorts-across-reply-branches ()
  (let* ((parent (notmuch-thread-test--message "parent" 10))
         (first-reply (notmuch-thread-test--message "first-reply" 20))
         (grandchild (notmuch-thread-test--message "grandchild" 40))
         (second-reply (notmuch-thread-test--message "second-reply" 30))
         (thread (list (list parent (list (list first-reply (list (list grandchild nil)))
                                         (list second-reply nil)))))
         (before (copy-tree thread))
         (ordered (notmuch-custom--newest-first-thread thread)))
    (should (equal (mapcar (lambda (node) (plist-get (car node) :id)) ordered)
                   '("grandchild" "second-reply" "first-reply" "parent")))
    (should (equal thread before))
    (should (eq (caar ordered) grandchild))
    (should (cl-every (lambda (node) (null (cadr node))) ordered))))

(ert-deftest notmuch-thread-newest-first-keeps-equal-dates-stable ()
  (let* ((first (notmuch-thread-test--message "first" 20))
         (second (notmuch-thread-test--message "second" 20))
         (thread (list (list first (list (list second nil))))))
    (should (equal (mapcar (lambda (node) (plist-get (car node) :id))
                          (notmuch-custom--newest-first-thread thread))
                   '("first" "second")))))

(ert-deftest notmuch-thread-newest-first-handles-missing-parent-and-date ()
  (let* ((missing-date (notmuch-thread-test--message "missing-date" nil))
         (dated (notmuch-thread-test--message "dated" 10))
         (thread (list (list nil (list (list missing-date nil) (list dated nil))))))
    (should (equal (mapcar (lambda (node) (plist-get (car node) :id))
                          (notmuch-custom--newest-first-thread thread))
                   '("dated" "missing-date")))
    (should-not (notmuch-custom--newest-first-thread nil))))

(ert-deftest notmuch-thread-newest-first-keeps-thread-groups-separate ()
  (let* ((notmuch-custom-show-newest-first t)
         (older-thread (list (list (notmuch-thread-test--message "older" 10) nil)))
         (newer-thread (list (list (notmuch-thread-test--message "newer" 40) nil)))
         (forest (list older-thread newer-thread))
         (result (notmuch-custom--show-newest-first #'identity forest)))
    (should (= (length result) 2))
    (should (equal (plist-get (caaar result) :id) "older"))
    (should (equal (plist-get (caar (cadr result)) :id) "newer"))))

(ert-deftest notmuch-thread-newest-first-can-restore-original-tree ()
  (let* ((notmuch-custom-show-newest-first nil)
         (forest (list (list (list (notmuch-thread-test--message "one" 10) nil)))))
    (should (eq (notmuch-custom--show-newest-first #'identity forest) forest))))

(ert-deftest notmuch-thread-newest-first-preserves-match-tags-and-message-data ()
  (let* ((matched (notmuch-thread-test--message "matched" 10 t))
         (unmatched (notmuch-thread-test--message "unmatched" 20 nil))
         (thread (list (list matched (list (list unmatched nil)))))
         (before (copy-tree thread))
         (ordered (notmuch-custom--newest-first-thread thread)))
    (should (= (length ordered) 2))
    (should-not (plist-get (caar ordered) :match))
    (should (plist-get (car (cadr ordered)) :match))
    (should (equal thread before))
    (should (equal (plist-get (caar ordered) :tags) '("inbox" "unread")))))

(ert-deftest notmuch-thread-newest-first-uses-normal-rendering-and-navigation ()
  (let* ((notmuch-custom-show-newest-first t)
         (notmuch-show-mark-read-tags nil)
         (notmuch-show-hook nil)
         (notmuch-show-previous-subject "")
         (parent (notmuch-thread-test--message "parent" 10 t))
         (reply (notmuch-thread-test--message "reply" 30 t))
         (forest (list (list (list parent (list (list reply nil)))))))
    (with-temp-buffer
      (notmuch-show-mode)
      (let ((inhibit-read-only t))
        (notmuch-custom--show-newest-first #'notmuch-show-insert-forest forest))
      (goto-char (point-min))
      (should (equal (notmuch-show-get-message-id t) "reply"))
      (should (= (notmuch-show-get-prop :depth) 0))
      (notmuch-show-goto-message-next)
      (should (equal (notmuch-show-get-message-id t) "parent"))
      (should (= (notmuch-show-get-prop :depth) 0))
      (notmuch-show-goto-message-previous)
      (should (equal (notmuch-show-get-message-id t) "reply")))))

(provide 'notmuch-thread-order-tests)
;;; notmuch-thread-order-tests.el ends here
